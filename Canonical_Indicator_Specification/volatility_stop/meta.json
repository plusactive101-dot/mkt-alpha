{
  "name": "Volatility Stop",
  "slug": "volatility_stop",
  "category": "Volatility",
  "subcategories": ["Trend", "Trailing_Stop"],
  "version": "1.0.0",
  "source_platform": "cTrader (C#)",
  "source_file": "original_source.cs",
  "description": "ATR-based dynamic trailing stop indicator with volatility ratchet (ratchets stop tighter as volatility contracts or price advances). Flips between bullish support line and bearish resistance line.",
  "inputs": [
    {
      "name": "period",
      "display_name": "ATR Period",
      "type": "integer",
      "default": 20,
      "min": 1,
      "max": 500,
      "description": "Lookback period for Average True Range calculation"
    },
    {
      "name": "multiplier",
      "display_name": "ATR Multiplier",
      "type": "float",
      "default": 3.0,
      "min": 0.1,
      "max": 20.0,
      "step": 0.1,
      "description": "Multiplier factor applied to the ATR to calculate the trailing stop distance"
    },
    {
      "name": "ma_type",
      "display_name": "ATR Moving Average Type",
      "type": "string",
      "default": "SMA",
      "options": ["SMA", "EMA", "RMA"],
      "description": "Smoothing method used inside ATR (SMA is standard in cTrader; RMA/Wilder is standard in TradingView)"
    }
  ],
  "outputs": [
    {
      "name": "stop",
      "display_name": "Stop Line",
      "type": "series_float",
      "description": "Active trailing stop price line (lower support when bullish, upper resistance when bearish)"
    },
    {
      "name": "is_bullish",
      "display_name": "Bullish Trend State",
      "type": "series_bool",
      "description": "True when in uptrend, False when in downtrend"
    },
    {
      "name": "bullish_stop",
      "display_name": "Bullish Stop Plot",
      "type": "series_float",
      "plot_style": "DiscontinuousLine",
      "color_hint": "LimeGreen",
      "description": "Bullish trailing stop plot line; NaN during downtrends"
    },
    {
      "name": "bearish_stop",
      "display_name": "Bearish Stop Plot",
      "type": "series_float",
      "plot_style": "DiscontinuousLine",
      "color_hint": "Crimson",
      "description": "Bearish trailing stop plot line; NaN during uptrends"
    },
    {
      "name": "trend_flip",
      "display_name": "Trend Flip Signal",
      "type": "series_int",
      "values": {
        "1": "Bearish to Bullish Flip",
        "-1": "Bullish to Bearish Flip",
        "0": "No Trend Change"
      },
      "description": "Signal flag fired on the bar where trend direction flips"
    }
  ],
